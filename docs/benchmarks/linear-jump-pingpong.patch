+namespace {
+void hash178_dump(const Model& model, const SearchResult& r) {
+    const char* path = std::getenv("CBLS_HASH_OUT");
+    if (path == nullptr) {
+        return;
+    }
+    uint64_t h = 1469598103934665603ULL;
+    auto mix = [&h](uint64_t x) {
+        for (int i = 0; i < 8; ++i) {
+            h ^= (x >> (8 * i)) & 0xffU;
+            h *= 1099511628211ULL;
+        }
+    };
+    auto mixd = [&mix](double d) {
+        uint64_t b = 0;
+        std::memcpy(&b, &d, sizeof b);
+        mix(b);
+    };
+    for (size_t v = 0; v < model.num_vars(); ++v) {
+        const Variable& var = model.var(static_cast<int32_t>(v));
+        mixd(var.value);
+        for (const auto e : var.elements) {
+            mix(static_cast<uint64_t>(e));
+        }
+    }
+    mix(static_cast<uint64_t>(r.iterations));
+    mixd(r.objective);
+    std::FILE* f = std::fopen(path, "a");
+    if (f != nullptr) {
+        std::fprintf(f, "%016llx %lld\n", static_cast<unsigned long long>(h),
+                     static_cast<long long>(r.iterations));
+        std::fclose(f);
+    }
+}
