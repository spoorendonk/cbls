+    int64_t tiny = 0;               // 0 < score <= 1e-12 * scale
+    int64_t tiny_float = 0;
+    int64_t tiny_float_cf = 0;
+    int64_t rev_float = 0;              // Float A->B->A inside one batch
+    int64_t rev_float_nobump = 0;       // ... with no bump in between
+    int64_t rev_float_nobump_tiny = 0;  // ... and both accepted scores tiny (DIRECT PING-PONG)
+    // Scorer engagement (LinearJumpScorer::prepare on Float vars).
+    int64_t float_prepare = 0;
+    int64_t float_prepare_fast = 0;
