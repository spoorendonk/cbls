+// ---- #178 instrumentation: reads only, never writes search state ----
+void FeasibilityJump::pp_record_accept(int32_t v, double s) {
+    pp178::Stats& st = pp178::stats();
+    ++st.accepted;
+    const auto& cids = model_.constraint_ids();
+    const auto& nodes = model_.nodes();
+    const ConstSpan<int32_t> gv = model_.constraints_of_var(v);
+    const Variable& var = model_.var(v);
+    const bool is_float = var.type == VarType::Float;
+    bool cf = std::isfinite(var.value);
+    double scale = 0.0;
+    for (const int32_t c : gv) {
+        const double w = vm_.weights[static_cast<size_t>(c)];
+        if (w == 0.0) {
+            continue;
+        }
+        cf = cf && linear_.row_eligible(c);
+        const ExprNode& nd = nodes[static_cast<size_t>(cids[static_cast<size_t>(c)])];
+        double mag = 0.0;
+        for (const ChildRef& ch : model_.children(nd)) {
+            const double val = ch.is_var ? model_.var(ch.id).value : model_.node_value(ch.id);
+            if (std::isfinite(val)) {
+                mag += std::abs(val);
+            }
+        }
+        scale += std::abs(w) * std::max(1.0, mag);
+    }
+    const bool tiny = s > 0.0 && s <= 1e-12 * scale;
+    st.tiny += tiny ? 1 : 0;
+    if (!is_float) {
+        return;
+    }
+    ++st.accepted_float;
+    st.accepted_float_cf += cf ? 1 : 0;
+    st.tiny_float += tiny ? 1 : 0;
+    st.tiny_float_cf += (tiny && cf) ? 1 : 0;
+    const auto n = static_cast<size_t>(model_.num_vars());
+    if (pp_model_ != &model_ || pp_last_from_.size() != n) {
+        pp_model_ = &model_;
+        pp_last_from_.assign(n, 0.0);
+        pp_last_to_.assign(n, 0.0);
+        pp_last_batch_.assign(n, -1);
+        pp_last_bump_.assign(n, -1);
+        pp_last_tiny_.assign(n, 0);
+    }
+    const auto i = static_cast<size_t>(v);
+    const double from = var.value;
+    const double to = jumps_.jump_value(v);
+    if (pp_last_batch_[i] == st.batch_epoch && from == pp_last_to_[i] && to == pp_last_from_[i]) {
+        ++st.rev_float;
+        if (pp_last_bump_[i] == st.bump_epoch) {
+            ++st.rev_float_nobump;
+            if (tiny && pp_last_tiny_[i] != 0) {
+                ++st.rev_float_nobump_tiny;
+            }
+        }
+    }
+    pp_last_from_[i] = from;
+    pp_last_to_[i] = to;
+    pp_last_batch_[i] = st.batch_epoch;
+    pp_last_bump_[i] = st.bump_epoch;
+    pp_last_tiny_[i] = tiny ? 1 : 0;
+}
+
+double FeasibilityJump::pp_exact_unweighted() const {
+    const auto& cids = model_.constraint_ids();
+    double total = 0.0;
+    for (size_t c = 0; c < cids.size(); ++c) {
+        const auto ci = static_cast<int32_t>(c);
+        if (ci == objective_ci_ || !active(ci)) {
+            continue;
+        }
+        total += progress_residual(model_.node_value(cids[c]));
+    }
+    return total;
+}
