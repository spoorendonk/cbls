@@ -0,0 +1,53 @@
+// #178 supplementary harness (ships only inside the #178 patch): the uc-chped model under
+// FeasibilityJump::run() with the default GFJConfig (two_phase = true), so the
+// linear phase masks the nonlinear objective row at weight 0 and the Float
+// dispatch columns can take the closed form. Iteration-bounded, no wall clock:
+// the result is deterministic per (instance, horizon, seed, arm).
+//
+// Usage: uc_twophase <file.jsonl> <horizon> <seed> <max_iterations>
+// Prints one line: status iterations max_violation; counters go to CBLS_PP_OUT.
+#include "benchmarks/uc-chped/data.h"
+#include "benchmarks/uc-chped/uc_model.h"
+
+#include <cbls/cbls.h>
+#include <cbls/feasibility_jump.h>
+#include <cbls/linear_jump.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+
+int main(int argc, char** argv) {
+    if (argc != 5) {
+        std::fprintf(stderr, "usage: uc_twophase file horizon seed max_iterations\n");
+        return 2;
+    }
+    const auto base = cbls::uc_chped::load_jsonl(argv[1]);
+    const int horizon = std::atoi(argv[2]);
+    const auto seed = static_cast<uint64_t>(std::atoll(argv[3]));
+    const auto max_it = static_cast<int64_t>(std::atoll(argv[4]));
+    const auto inst =
+        horizon < base.n_periods ? cbls::uc_chped::make_subinstance(base, horizon) : base;
+    auto ucm = cbls::uc_chped::build_uc_model(inst);
+    cbls::Model& m = ucm.model;
+    // As solve() does: the objective becomes a row `obj <= bound`, opened at +inf.
+    m.add_objective_soft_constraint();
+    m.set_objective_bound(std::numeric_limits<double>::infinity());
+    cbls::ViolationManager vm(m);
+    cbls::RNG rng(seed);
+    cbls::GFJConfig cfg;  // defaults: two_phase = true, set_initial_x = true
+    cfg.max_iterations = max_it;
+    cbls::FeasibilityJump fj(m, vm, rng, cfg);
+    const cbls::GFJStatus st = fj.run();
+    double maxv = 0.0;
+    for (const int32_t cid : m.constraint_ids()) {
+        const double v = m.node_value(cid);
+        if (v > maxv) {
+            maxv = v;
+        }
+    }
+    std::printf("%s %lld %.17g\n", st == cbls::GFJStatus::Feasible ? "feasible" : "unsolved",
+                static_cast<long long>(fj.iterations()), maxv);
+    cbls::pp178::dump("twophase");
+    return 0;
+}
