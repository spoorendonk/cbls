# Check contract for the clang-tidy runs in .githooks/pre-commit (safe --fix
# subset) and .githooks/pre-push (full sweep, warn-only).
#
# Owned by this repository, like its sibling .clang-format.
#
# Where this file departs from stock Google style the reason is recorded
# inline, with the measurement that justifies it. Nothing is turned off to
# avoid work.
---
# Three checks are disabled below the stock set, each for a structural reason
# rather than to dodge work:
#
#   bugprone-chained-comparison -- Catch2's REQUIRE/CHECK decompose into an
#     expression template, so every `REQUIRE(a == b)` reads to this check as the
#     chained comparison `v0 <= v1 > v2`. Measured: 548 hits, all in tests/, all
#     of them the macro rather than the test. Nothing to fix at the call site.
#
#   bugprone-throwing-static-initialization -- Catch2's TEST_CASE registers each
#     case through a static (`dummyUser1`, ...) whose initialization the check
#     cannot prove non-throwing. 276 hits, one per TEST_CASE; the construct is
#     Catch2's, not ours.
#
#   readability-identifier-length -- 1515 hits, by far the largest single source
#     of noise, objecting to `x`, `y`, `lb`, `ub`, `id`. This is a solver: those
#     are the domain's own names and the papers the code implements use exactly
#     them. Renaming `x` to `x_var` across the DAG and the AD paths would make
#     the code read *less* like its reference. Same call, and same reasoning, as
#     the identifier-naming options below: encode the convention the project
#     actually has.
#
# Below those three sits a RATCHET. Every check that still fired once the safe
# auto-fixes had landed is disabled here, so that the rest of
# bugprone-*/modernize-*/performance-*/readability-* can block at push starting
# now. These are off because they are UNFIXED, not because they are wrong.
#
# Counts were re-derived at the commit that restored linting to src/io/, with
# the sweep command in issue #121 and 26 checks disabled. They rose 248 -> 296
# there for two independent reasons, so do not compare them against an older
# revision of this list without re-running that sweep:
#   * 36 of the findings are in src/io/, which contributed nothing before
#     because its .clang-tidy was missing `InheritParentConfig: true` and so
#     ran no checks at all. 4 of those 36 are readability-identifier-naming in
#     the vendored mps_reader.cpp, which that directory still exempts by
#     design -- they are excluded below, so that measurement totalled 296.
#   * the rest is ordinary drift in the tree since the counts were first taken.
#
# Re-derive, never increment: a count here is a floor for the work, and
# deleting a line whose findings you sized from a stale number turns the push
# gate red for everyone. The same goes for the running total below -- re-run
# the sweep, do not subtract.
#
# TOTAL: 290
#
#    63  readability-function-cognitive-complexity
#    40  readability-implicit-bool-conversion
#    28  modernize-use-auto
#    25  readability-math-missing-parentheses
#    24  readability-identifier-naming
#    23  bugprone-easily-swappable-parameters
#    17  modernize-avoid-c-style-cast
#     9  bugprone-unchecked-string-to-number-conversion
#     9  performance-inefficient-vector-operation
#     8  bugprone-narrowing-conversions
#     8  performance-enum-size
#     7  modernize-avoid-c-arrays
#     6  readability-inconsistent-declaration-parameter-name
#     5  readability-avoid-nested-conditional-operator
#     4  bugprone-exception-escape
#     4  readability-use-anyofallof
#     3  readability-redundant-casting
#     3  readability-use-std-min-max
#     2  bugprone-branch-clone
#     2  bugprone-unchecked-optional-access
#
# Deleting a line from that list is how a check comes back. Do it in the same
# commit that fixes its warnings, never on its own. See the tracking issue for
# the counts above and the suggested order: issue #121.
#
# Note `#` is NOT a comment inside a `>` folded scalar -- it is literal text
# that silently corrupts the check list, and a trailing `# 25` on a check line
# swallows the line after it. Every comment goes here, above the key; the
# scalar itself holds check names and nothing else.
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -bugprone-chained-comparison,
  -bugprone-throwing-static-initialization,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion,
  -readability-math-missing-parentheses,
  -readability-identifier-naming,
  -modernize-avoid-c-style-cast,
  -bugprone-easily-swappable-parameters,
  -modernize-use-auto,
  -performance-inefficient-vector-operation,
  -bugprone-unchecked-string-to-number-conversion,
  -bugprone-narrowing-conversions,
  -performance-enum-size,
  -readability-inconsistent-declaration-parameter-name,
  -modernize-avoid-c-arrays,
  -readability-avoid-nested-conditional-operator,
  -bugprone-exception-escape,
  -readability-use-anyofallof,
  -readability-redundant-casting,
  -readability-use-std-min-max,
  -bugprone-branch-clone,
  -bugprone-unchecked-optional-access

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  # Measured over include/cbls/*.h and src/*.cpp, this codebase runs 336
  # lower_case functions to 14 CamelCase (all constructors, which take the
  # class name) -- `full_evaluate`, `delta_evaluate`,
  # `weighted_violation_delta`, `augmented_objective`. camelBack would flag
  # 198 of them in src/search.cpp alone, i.e. a gate that objects to the
  # convention the project actually has. Google style permits either
  # spelling; encode the real one.
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  # The typed-variable factory API on Model is deliberately CamelCase: each
  # method names the variable type it creates (`m.Bool()`, `m.Int()`), and
  # `bool`/`int`/`float` cannot be spelled lower_case at all without
  # colliding with a keyword -- clang-tidy says so itself and declines to
  # fix them. Six methods, the only survivors of the naming sweep.
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^(Bool|Int|Float|List|Set|Constant)$'
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  # A single ConstantCase of UPPER_CASE is a spelling used nowhere here, and
  # clang-tidy applies "constant" to every `const` local and `const`
  # parameter as well as to file-scope tables. Split by scope to match the
  # code: file-scope, static, class and constexpr constants are k-prefixed
  # CamelCase (15 measured, e.g. `kMaxStaleRounds`); `const` locals and
  # parameters are ordinary lower_case and carry no marker.
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.LocalConstantPointerCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstantPointerParameterCase
    value: lower_case
  # ConstantMemberCase is deliberately left unset. It takes precedence over
  # PrivateMemberSuffix, so setting it to lower_case would reject a `const`
  # private member spelled with this project's `_` suffix, while setting it
  # to lower_case-with-`_` would then demand the suffix on public `const`
  # members that correctly have none. Unset, const members fall through to
  # the member rules below, which is the intent.
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

WarningsAsErrors: ''
# '.*' meant every transitively included header, so a sweep reported ~9400
# diagnostics from build/_deps (Catch2, nlohmann/json), nanobind, CPython and
# libstdc++ -- none of it code this repo can change, and enough of it to bury
# the diagnostics that are ours. Keep the broad filter and subtract what we do
# not own, so a new project header is covered by default rather than by being
# remembered.
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(build/_deps/|site-packages/|/usr/include/|/usr/lib/|/usr/bin/)'
FormatStyle: file
