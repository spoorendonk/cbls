# Check contract for the clang-tidy runs in .githooks/pre-commit (safe --fix
# subset) and .githooks/pre-push (full sweep, warn-only).
#
# Owned by this repository, like its sibling .clang-format. It began as a
# shared house check set carried in the .devkit tooling submodule; that
# submodule is gone and this file is now the source.
#
# Every deviation from the inherited set is marked NARROWED and carries the
# measurement that justifies it. Nothing is turned off to avoid work.
---
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers

CheckOptions:
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  # NARROWED: the inherited set shipped camelBack. Measured over
  # include/cbls/*.h and src/*.cpp, this codebase is 336 lower_case
  # functions to 14 CamelCase (all constructors, which take the class
  # name) -- `full_evaluate`, `delta_evaluate`, `weighted_violation_delta`,
  # `augmented_objective`. camelBack produced 198 naming warnings in
  # src/search.cpp alone, i.e. a gate that flags the convention the project
  # actually has. Google style permits either spelling; encode the real one.
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  # The typed-variable factory API on Model is deliberately CamelCase: each
  # method names the variable type it creates (`m.Bool()`, `m.Int()`), and
  # `bool`/`int`/`float` cannot be spelled lower_case at all without
  # colliding with a keyword -- clang-tidy says so itself and declines to
  # fix them. Six methods, the only survivors of the naming sweep.
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^(Bool|Int|Float|List|Set|Constant)$'
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  # NARROWED: the inherited set shipped one ConstantCase of UPPER_CASE, a
  # spelling used nowhere here, and clang-tidy applies "constant" to every
  # `const` local and `const` parameter as well as to file-scope tables.
  # Split by scope to match the code: file-scope, static, class and
  # constexpr constants are k-prefixed CamelCase (15 measured, e.g.
  # `kMaxStaleRounds`); `const` locals and parameters are ordinary
  # lower_case and carry no marker.
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case
  - key: readability-identifier-naming.LocalConstantPointerCase
    value: lower_case
  - key: readability-identifier-naming.ConstantParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstantPointerParameterCase
    value: lower_case
  # ConstantMemberCase is deliberately left unset. It takes precedence over
  # PrivateMemberSuffix, so setting it to lower_case would reject a `const`
  # private member spelled with this project's `_` suffix, while setting it
  # to lower_case-with-`_` would then demand the suffix on public `const`
  # members that correctly have none. Unset, const members fall through to
  # the member rules below, which is the intent.
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.ClassConstantCase
    value: CamelCase
  - key: readability-identifier-naming.ClassConstantPrefix
    value: k
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: file
