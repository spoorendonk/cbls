build*/
# No trailing slash: in a git worktree `.venv` is a SYMLINK to the main
# checkout's venv (see CLAUDE.md, Build & Test), and `.venv/` does not match a
# symlink -- so `git add -A` there would commit it.
.venv
*.egg-info/
__pycache__/
*.pyc
*.so
*.dylib
*.dll
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
.cache/
.pytest_cache/
*.o
results/
# ...except the MIPfeas parity fixture, which is a committed test *input* rather
# than a run artifact: tests/python/test_mipfeas_parity.py regenerates the two
# artifacts beside it from this directory and compares them byte for byte, so
# `results/` above swallowing it would leave that test passing only on the
# machine that generated it (issue #139).
!benchmarks/mipfeas/testdata/results/

# Profiling artifacts. docs/profiling.md says to run these in a scratch
# directory; this is the backstop for when one lands here anyway.
perf.data
perf.data.old
gmon.out
*.heap
callgrind.out.*

# Local agent/dev tooling — not part of the repo.  The gates that matter are
# tracked in .githooks/ (wired up by `cmake -B build`).
.claude/
.codex/
