#!/bin/bash
# Git pre-commit hook.
#
# Flow:
#   1. Auto-format + auto-fix lint (staged files only)
#   2. Tests → hard block (no bypass)
#
# This directory is the source for the git hooks — edit them here.
#
# SC2086: the *_FILES variables hold newline-separated path lists that are
# meant to word-split into multiple arguments; quoting them would pass one
# argument containing newlines and break every tool invocation.  SC1091: the
# sourced resolve-venv.sh is not followed without -x.
# shellcheck disable=SC2086,SC1091

set -e

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null || true)

[ -z "$STAGED_FILES" ] && exit 0

CPP_FILES=$(echo "$STAGED_FILES" | grep -E '\.(cpp|cc|cxx|h|hpp|hxx)$' || true)
PY_FILES=$(echo "$STAGED_FILES" | grep -E '\.py$' || true)
# The tracked hooks themselves are extensionless shell scripts; include them so
# shfmt keeps this directory formatted like every other script.
SH_FILES=$(echo "$STAGED_FILES" | grep -E '\.sh$|^\.githooks/[^/.]+$' || true)

# Sourced unconditionally, not only for Python: the clang tools this hook runs
# are the pinned PyPI ones inside the venv, not system packages.
source "$(dirname "$0")/resolve-venv.sh"

# Prefer the venv's pinned clang-format/clang-tidy over whatever is on PATH.
# clang-format's output changes between major releases, so a PATH copy of a
# different vintage would reformat differently from everyone else's commit --
# and on a machine with no system clang tools at all (the common case here) a
# bare `command -v` check silently formats nothing. Fall back to PATH, and say
# so when neither exists rather than passing quietly.
CLANG_FORMAT=""
[ -x "$VENV_BIN/clang-format" ] && CLANG_FORMAT="$VENV_BIN/clang-format"
[ -z "$CLANG_FORMAT" ] && command -v clang-format &>/dev/null && CLANG_FORMAT="clang-format"

CLANG_TIDY=""
[ -x "$VENV_BIN/clang-tidy" ] && CLANG_TIDY="$VENV_BIN/clang-tidy"
[ -z "$CLANG_TIDY" ] && command -v clang-tidy &>/dev/null && CLANG_TIDY="clang-tidy"

# ============================================================
# Step 1: Auto-format and auto-fix
# ============================================================

# C++ formatting
if [ -n "$CPP_FILES" ]; then
	if [ -n "$CLANG_FORMAT" ]; then
		"$CLANG_FORMAT" -i $CPP_FILES || true
	else
		echo "NOTE: no clang-format found (venv or PATH) — staged C++ NOT formatted."
		echo "      Install it with: .venv/bin/pip install -e '.[dev]'"
	fi
fi

# Shell script formatting
if [ -n "$SH_FILES" ] && command -v shfmt &>/dev/null; then
	shfmt -w $SH_FILES || true
fi

# Python formatting + auto-fixable lint
if [ -n "$PY_FILES" ] && [ -x "$VENV_BIN/ruff" ]; then
	"$VENV_BIN/ruff" format --quiet $PY_FILES
	"$VENV_BIN/ruff" check --fix --quiet $PY_FILES 2>/dev/null || true
fi

# C++ auto-fixable lint (safe clang-tidy fixes only)
if [ -n "$CPP_FILES" ] && [ -n "$CLANG_TIDY" ]; then
	COMPILE_DB=""
	[ -f "build/compile_commands.json" ] && COMPILE_DB="-p build"
	[ -f "compile_commands.json" ] && COMPILE_DB="-p ."

	if [ -n "$COMPILE_DB" ]; then
		for f in $CPP_FILES; do
			"$CLANG_TIDY" $COMPILE_DB \
				--checks="-*,modernize-use-nullptr,modernize-use-override,modernize-use-using,readability-braces-around-statements" \
				--fix --quiet "$f" 2>/dev/null || true
		done
	fi
fi

# Re-stage files modified by formatting/lint fixes
while read -r f; do
	git add "$f"
done < <(git diff --name-only -- $STAGED_FILES 2>/dev/null)

# ============================================================
# Step 2: Tests (hard block)
# ============================================================

echo "=== Pre-commit: running tests ==="

TESTS_FAILED=0

# Only run C++ tests if C++ files were staged
if [ -n "$CPP_FILES" ] && [ -d "build" ] && command -v ctest &>/dev/null; then
	# -LE slow deliberately: this is the fast inner loop, 304 of the 313
	# tests. The 9 tests it skips are the 6 [slow]-tagged CHPED and UC-CHPED
	# solves, worth ~103s of the suite's aggregate (summed per-test) time --
	# ~40s of wall clock with -j at Release -- plus the 3 #125 throughput
	# floors, which are labelled slow (though not [slow]-tagged) so their
	# wall-clock budgets stay out of this loop. pre-push runs the whole suite
	# from a clean tree anyway. The margin is much narrower than it was at
	# -O0 (40s vs 8s, not 304s vs 7s), so the split now buys an inner loop
	# that stays under ten seconds rather than one that avoids a six-minute
	# commit.
	echo "Running C++ tests (fast set; [slow] runs at push)..."
	if ! ctest --test-dir build -LE slow --output-on-failure --progress -j"$(nproc 2>/dev/null || echo 4)"; then
		echo "FAILED: C++ tests failed."
		TESTS_FAILED=1
	fi
elif [ -n "$CPP_FILES" ]; then
	# A fresh clone or worktree has no build/ yet, so this commits C++ with no
	# test coverage at all.  That is survivable — pre-push rebuilds clean — but
	# it must not look like the tests ran and passed.
	echo "NOTE: staged C++ but no build/ directory — C++ tests NOT run."
	echo "      Run \`cmake -B build\` to get test coverage at commit time."
fi

# Only run Python tests if Python files were staged
if [ -n "$PY_FILES" ] && [ -x "$VENV_BIN/pytest" ]; then
	echo "Running Python tests..."
	rc=0
	"$VENV_BIN/pytest" --tb=short -q || rc=$?
	# rc=0: passed, rc=5: no tests collected (all skipped) — both OK
	if [ "$rc" -ne 0 ] && [ "$rc" -ne 5 ]; then
		echo "FAILED: Python tests failed."
		TESTS_FAILED=1
	fi
fi

if [ "$TESTS_FAILED" -ne 0 ]; then
	echo ""
	echo "Commit blocked: tests failed. Fix tests before committing."
	exit 1
fi

echo "Tests passed."
exit 0
