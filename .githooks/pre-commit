#!/bin/sh
# wcp: pre-commit base=c1bc4d446e37
# Format, lint and type-check the Python half, and check the C++ half's format,
# before the commit is made.
#
# A real file in this repository, not a shim — see the note in `commit-msg` for
# what the `# wcp:` line above is for and why editing this is allowed. This is
# the one hook that differs by project type: wcp installs the variant matching
# the type recorded for this repository, and this is the union of the Python and
# C++ ones rather than either.
#
# **The C++ half fails open, loudly; the Python half fails closed (#371).** git
# reads any non-zero exit as a refusal. A missing clang-format, or one of
# another major version than the project pins, is announced on stderr and the
# commit proceeds. ruff and mypy are different: they are pinned in this
# project's dev extra, a clone that cannot run them has skipped the setup
# CLAUDE.md requires (`uv sync`, which needs no commit), and skipping them let
# commits through unchecked. So a Python tool that cannot run refuses the
# commit and says what to run.
#
# **Format only, for C++ (#178).** No hook runs clang-tidy over the changed
# files: tidying here ran a header's every includer at each commit, and
# pre-push's test fence runs only `clang_tidy_gate_probe`, which checks that the
# config still reports diagnostics, not the tree. Zero clang-tidy findings is
# checked by hand before a push (CLAUDE.md, **Git Hooks**).
#
# **Both halves run.** A binding is two languages that have to agree, and a
# commit that formats one of them is a commit that half-checked itself. Neither
# half's failure stops the other from being reported.

set -u

status=0

# ------------------------------------------------------------------- Python
#
# The whole tree, not the staged files: `ruff` and `mypy` are configured for the
# project in `pyproject.toml`, and mypy in particular cannot type-check a file
# without the modules it imports.

run() {
	printf 'pre-commit: %s\n' "$*" >&2
	"$@" || status=1
}

# **`--no-sync` (#371).** A plain `uv run` syncs the project first, and here a
# sync after any change to `pyproject.toml` rebuilds the editable C++ extension:
# a full scikit-build-core build of the library and its tests (about 1.5 min at
# -j2), run inside the hook, outside the machine's build lock and at ninja's
# default parallelism. On the Mac mini that build failed in the hook ("Failed
# to build cbls"; a rerun under the hook's environment at -j2 built cleanly, so
# why it failed is not known). The venv kept its old install, so every later
# commit retried the build and failed, and the probe read the failure as a
# missing tool and skipped ruff and mypy. `--no-sync` runs the tools in the venv
# as it stands; `uv sync` keeps it current.
uvrun() { uv run --no-sync --quiet "$@"; }

# Can this tool be run at all? Asked once per tool, so a tool that cannot start
# gets one clear message, uv's own first line included, instead of three
# failures that read as lint findings.
have() {
	probe=$(uvrun "$1" --version 2>&1)
	if [ $? -eq 0 ]; then
		return 0
	fi
	printf 'pre-commit: could not run %s: %s\n' "$1" "$(printf '%s' "$probe" | head -n 1)" >&2
	return 1
}

cannot_run() {
	printf 'pre-commit: %s could not be run, so %s not run. Set up the venv with `uv sync --extra dev --extra benchmarks` and commit again.\n' \
		"$1" "$2" >&2
	status=1
}

if ! command -v uv >/dev/null 2>&1; then
	cannot_run uv "the format, lint and type checks were"
else
	if have ruff; then
		run uvrun ruff format --check .
		run uvrun ruff check .
	else
		cannot_run ruff "the format and lint checks were"
	fi
	if have mypy; then
		run uvrun mypy .
	else
		cannot_run mypy "the type check was"
	fi
fi

# ---------------------------------------------------------------------- C++
#
# Tracked files, not staged ones: a commit is checked as the tree it leaves.

# Prefer the project's pinned clang tools in `.venv/bin`, when it has them, over
# whatever is on PATH: clang-format's output changes between major versions. A
# linked worktree (`git worktree add`) has no `.venv` of its own, as it is
# untracked, or one `uv run` made that holds only what the project declares, so
# the main checkout's comes next: the directory holding the common git
# directory, when that is a `.git` (not a submodule's, or a bare repository
# elsewhere). Both, tool by tool, the worktree's own first.
if common=$(git rev-parse --git-common-dir 2>/dev/null) &&
	common=$(CDPATH='' cd -- "$common" 2>/dev/null && pwd) &&
	[ "${common%/.git}" != "$common" ] && [ -d "${common%/.git}/.venv/bin" ]; then
	PATH="${common%/.git}/.venv/bin:$PATH"
fi
[ ! -d .venv/bin ] || PATH="$PWD/.venv/bin:$PATH"

# **The pinned major version, when the project declares one**: the first line
# of `.clang-format-version`, `22` or `22.1.8`, of which only the major is
# compared. A clang-format of another major formats differently and would
# report violations in files the commit never touched, so it is not run: the
# format check is skipped, loudly, as for a missing tool. Without the file,
# whichever clang-format is found is used.
pin_major=''
if [ -f .clang-format-version ]; then
	pin=$(sed -n '1{s/^[[:space:]]*//;s/[[:space:]]*$//;p;}' .clang-format-version)
	pin_major=${pin%%.*}
	case $pin_major in
	'' | *[!0-9]*)
		printf 'pre-commit: .clang-format-version does not begin with a version ("%s"); the clang-format version was not checked.\n' \
			"$pin" >&2
		pin_major=''
		;;
	esac
fi
# The major version of the clang-format on PATH, or nothing when its
# `--version` line cannot be read.
format_major() {
	clang-format --version 2>/dev/null |
		sed -n 's/.*clang-format version \([0-9][0-9]*\).*/\1/p' | sed -n 1p
}

# Newline-separated paths on stdin, run as `xargs -0 ARGS... PATHS`: a path
# with a space in it stays one path. `-0` is in POSIX since 2024, and GNU, BSD
# and busybox have long had it.
each_path() { grep -v '^$' | tr '\n' '\000' | xargs -0 "$@"; }

# quotePath off, so a non-ASCII path is listed as itself rather than C-quoted.
sources=$(git -c core.quotePath=false ls-files -- '*.c' '*.cc' '*.cpp' '*.cxx' 2>/dev/null)
headers=$(git -c core.quotePath=false ls-files -- '*.h' '*.hh' '*.hpp' '*.hxx' 2>/dev/null)
formattable=$(printf '%s\n%s\n' "$sources" "$headers" | grep -v '^$')

if ! command -v clang-format >/dev/null 2>&1; then
	echo "pre-commit: clang-format is not on PATH; the format check was skipped." >&2
elif [ -z "$formattable" ]; then
	: # nothing to format
elif [ -n "$pin_major" ] && found=$(format_major) && [ "$found" != "$pin_major" ]; then
	printf 'pre-commit: %s is clang-format %s, not %s as .clang-format-version pins; the format check was skipped. Put clang-format %s first on PATH, or in .venv/bin.\n' \
		"$(command -v clang-format)" "${found:-of an unknown version}" "$pin_major" "$pin_major" >&2
else
	echo "pre-commit: clang-format --dry-run -Werror" >&2
	# One process over every tracked file (xargs splits only at the argument
	# limit): about a second for a whole tree.
	printf '%s\n' "$formattable" | each_path clang-format --dry-run -Werror -- || status=1
fi

if [ "$status" -ne 0 ]; then
	echo "Commit blocked: fix the failures above and commit again." >&2
fi
exit "$status"
