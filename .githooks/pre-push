#!/bin/bash
# Git pre-push hook.
# Final gate before sharing code — catches what pre-commit doesn't.
#
# Flow:
#   1. Python lint + type gate → block on failure (cheapest, so it runs first)
#   2. Clean build + test → block on failure, and on any compiler warning in
#      first-party code (issue #171)
#   3. clang-tidy + its gate probe → block; complexity, shellcheck and mypy
#      over the pushed files → warn and continue
#
# There is no /review stamp gate. It was removed with the .claude/ review
# command when .claude/ became gitignored local tooling: the gate could only
# ever be satisfied in the one checkout that happened to carry the command,
# and it silently did nothing everywhere else.
#
# This directory is the source for the git hooks — edit them here.
#
# SC2086: the *_FILES variables -- PY_GATE_FILES included -- hold
# newline-separated path lists that are meant to word-split into multiple
# arguments; quoting them would pass one argument containing newlines and break
# every tool invocation.  SC1091: the sourced resolve-venv.sh is not followed
# without -x.
# shellcheck disable=SC2086,SC1091

set -e

# Git feeds one line per ref being pushed:
#   <local ref> <local sha> <remote ref> <remote sha>
# and an all-zero local sha means that ref is being deleted.  A deletion
# changes no code, so gating it on a clean rebuild is pure waste -- and the
# gate would be nonsense anyway, since everything below inspects HEAD, which
# has nothing to do with the ref being removed.  (`git push origin --delete`
# otherwise wipes build/ and runs the full suite before removing a branch.)
#
# Only read when stdin is not a terminal, so running this hook by hand to test
# it does not block waiting for EOF.
PUSH_REFS=""
[ -t 0 ] || PUSH_REFS=$(cat)
if [ -n "$PUSH_REFS" ] && ! echo "$PUSH_REFS" | grep -qvE '^[^ ]+ 0+ '; then
	echo "pre-push: deletion only — nothing to gate."
	exit 0
fi

# Get changed files vs main
MAIN_BRANCH="main"
git rev-parse --verify "origin/$MAIN_BRANCH" &>/dev/null || MAIN_BRANCH="master"
git fetch origin "$MAIN_BRANCH" --quiet 2>/dev/null || true
CHANGED_FILES=$(git diff --name-only "origin/$MAIN_BRANCH"...HEAD 2>/dev/null || git diff --name-only HEAD~1 2>/dev/null || true)

if [ -z "$CHANGED_FILES" ]; then
	# Usually a genuine no-op push.  It is also what a repo with no upstream
	# yet produces, in which case every gate below is skipped — say so rather
	# than exiting silently.
	echo "pre-push: no changes vs origin/$MAIN_BRANCH — nothing to gate."
	exit 0
fi

# .githooks/ is excluded: its one C++ file is the gate probe, which is
# deliberately not clean and is linted by tidy-probe.sh below, not here.
CPP_FILES=$(echo "$CHANGED_FILES" | grep -E '\.(cpp|cc|cxx|h|hpp|hxx)$' | grep -vE '^\.githooks/' || true)
# A .clang-tidy edit is how the gate itself breaks: a missing
# InheritParentConfig silently disabled every check under src/io/ for as long
# as that file existed (issue #121). Such a push touches no source file, so the
# clang-tidy loop below would run over nothing and report success -- the same
# fail-open class. Seed one canary translation unit per config directory so
# every config actually gets exercised.
if echo "$CHANGED_FILES" | grep -qE '(^|/)\.clang-tidy$'; then
	for canary in src/search.cpp src/io/mps_to_model.cpp; do
		if [ -f "$canary" ]; then
			CPP_FILES="${CPP_FILES}"$'\n'"$canary"
		fi
	done
fi
# A canary proves each config still RUNS checks; it cannot prove the gate still
# sees compiler diagnostics, because a clean canary reads the same either way.
# That needs a TU that is meant to be reported: tidy-probe.sh (issue #171) lints
# an incomplete enum-class switch under each directory's effective config and
# fails unless it is reported. Run it whenever the push could change the answer
# -- a .clang-tidy (the check list), a CMakeLists.txt (the -Wall -Wextra that
# clang-tidy reads from compile_commands.json), or the probe itself. ctest runs
# the same script as clang_tidy_gate_probe, so the full suite covers it too.
TIDY_PROBE=0
if echo "$CHANGED_FILES" | grep -qE '(^|/)\.clang-tidy$|(^|/)CMakeLists\.txt$|^\.githooks/tidy-probe'; then
	TIDY_PROBE=1
fi
PY_FILES=$(echo "$CHANGED_FILES" | grep -E '\.py$' || true)
# The tracked hooks themselves are extensionless shell scripts; include them so
# the linter below sees the file it is meant to police.  (Never begin a comment
# line with the linter's own name: that parses as a malformed directive and
# aborts analysis of the whole file.)
SH_FILES=$(echo "$CHANGED_FILES" | grep -E '\.sh$|^\.githooks/[^/.]+$' || true)

# Python venv — required for all Python tooling
if [ -n "$PY_FILES" ] || [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
	source "$(dirname "$0")/resolve-venv.sh"
fi

# Check if only non-code files changed (skip build+test for docs-only pushes).
# .githooks/ is excluded: a hook change cannot alter build or test outcomes, so
# a hooks-only push should not pay for a clean rebuild -- except the gate probe
# (issue #171), which CMake compiles into compile_commands.json and ctest runs
# as clang_tidy_gate_probe, so a change to it is added back as code below.
#
# `.txt` is deliberately NOT in the docs extension list. Every tracked .txt in
# this repo is load-bearing -- the three CMakeLists.txt files and the setcover
# instance data that tests/test_setcover.cpp reads -- so treating the extension
# as documentation silently skipped the whole gate on any build-system change.
# Misclassifying a real doc as code costs one clean cycle; misclassifying code
# as a doc pushes it untested, so the extension list errs toward running.
CODE_FILES=$(echo "$CHANGED_FILES" | grep -vE '^(LICENSE|CHANGELOG)' | grep -vE '\.(md|rst)$' | grep -vE '^\.(gitignore|gitattributes)$' | grep -vE '^\.githooks/' || true)
PROBE_CHANGES=$(echo "$CHANGED_FILES" | grep -E '^\.githooks/(tidy-probe|gate-lib|tests/)' || true)
[ -z "$PROBE_CHANGES" ] || CODE_FILES="${CODE_FILES}"$'\n'"${PROBE_CHANGES}"

# ============================================================
# Step 1: Python lint + type gate (hard block)
# ============================================================
#
# First because it is the cheapest hard block in this file and, unlike
# clang-tidy, it depends on nothing the build produces. Reported from Step 3
# instead, a missing `-> None` costs a clean rebuild and the full suite before
# the developer hears about it, then the same again after the one-line fix.
#
# BLOCKING, and over the whole tracked Python surface rather than over the
# files this push happens to touch. The advisory ruff/mypy steps in Step 3 see
# only $PY_FILES, which is two independent escape routes at once: a module
# nobody has edited in months is never staged (so pre-commit never lints it)
# and never appears in $PY_FILES (so those steps never see it); and even when
# it does appear, a finding there only prints a warning. pre-commit is weaker
# still than "staged files only" suggests -- its ruff step auto-fixes and
# swallows the rest, so a non-fixable finding such as E741 survives staging
# however often the file is edited. Five binding-test modules accumulated 139
# `mypy --strict` errors and 9 ruff errors that way, with every gate green
# throughout (issue #154).
#
# The scope is an EXCLUSION, not an allowlist, and that is the point: an
# allowlist is fail-open in the one direction that matters, because a Python
# directory that does not exist yet would be gated by nothing and could rot
# exactly as those five modules did. So the gate is every tracked .py except
# the one tree that cannot be clean yet (issue #155). The LIST comes from
# `git ls-tree HEAD`, so an untracked .py is not gated and a .py added in an
# unpushed commit is; the CONTENT the tools read is the working tree, so an
# uncommitted delete of a gated file is reported as a tooling fault rather than
# as a code finding. The failure message says so.
#
# ruff sees exactly that list. mypy FOLLOWS IMPORTS, so anything an excluded
# module imports would be type-checked anyway -- which is why a partial exclusion
# was never the safety it looked like, and why #155 emptied it rather than
# maintaining one.
#
# PY_GATE_EXCLUDE below is the scope itself -- the source of truth, and the one
# string to edit when #155 lands; every message here interpolates it rather than
# spelling the directory out again. CLAUDE.md's "Where that standard is actually
# enforced" carries the reasoning, the measurements and that trap; don't restate
# those here.
# Empty: the gate now covers every tracked .py, benchmarks included (#155). Kept
# as a variable rather than deleted, because the messages below interpolate it and
# because an exclusion is how a future tree that genuinely cannot be clean gets
# carved out -- with the reason written here, not by widening in silence.
PY_GATE_EXCLUDE=''
if [ -n "$PY_GATE_EXCLUDE" ]; then
	PY_GATE_FILES=$(git ls-tree -r HEAD --name-only | grep -E '\.py$' | grep -vE "$PY_GATE_EXCLUDE" || true)
else
	PY_GATE_FILES=$(git ls-tree -r HEAD --name-only | grep -E '\.py$' || true)
fi
PY_GATE_ISSUES=""
PY_GATE_TOOL_ERR=0

# Every precondition is a finding, never a skip. There is deliberately no
# `[ -n "$VENV_BIN" ]` wrapper: resolve-venv.sh above either sets VENV_BIN or
# exits 2, because this repo always has a pyproject.toml, so an empty VENV_BIN
# here means the resolve step never ran -- a fault, not a reason to pass the
# push. Same for a missing tool and for an empty file list. Every other Python
# step in these hooks guards on `-x` and skips in silence, which is precisely
# how a gate reports success without having run.
if [ -z "$VENV_BIN" ]; then
	PY_GATE_ISSUES="resolve-venv.sh left VENV_BIN empty -- the Python gate could not run"$'\n'
	PY_GATE_TOOL_ERR=1
fi
if [ -z "$PY_GATE_FILES" ]; then
	PY_GATE_ISSUES="${PY_GATE_ISSUES}no tracked .py file matched -- the gate ran on nothing"$'\n'
	PY_GATE_TOOL_ERR=1
fi
for tool in ruff mypy; do
	if [ -n "$VENV_BIN" ] && [ ! -x "$VENV_BIN/$tool" ]; then
		PY_GATE_ISSUES="${PY_GATE_ISSUES}${tool} is not in ${VENV_BIN} -- run: ${VENV_BIN}/pip install -e '.[dev]'"$'\n'
		PY_GATE_TOOL_ERR=1
	fi
done

# Run one gate step, naming it in any finding it produces.
#
# `out=$(...)` on its own line rather than `local out=$(...)`: `local` is a
# command, so it would swallow the exit status this whole function is about.
# The `&& rc=0 || rc=$?` pair is what keeps `set -e` from aborting the hook on
# a finding instead of collecting it.
#
# rc 1 is a finding, rc >= 2 is a tool or configuration fault -- ruff and mypy
# both draw the line there, and the two get different advice at the bottom, the
# way clang-tidy's config faults already do. Without the split, "mypy: cannot
# read file" would print "an untyped test function wants `-> None`".
py_gate_run() {
	local label="$1"
	shift
	local out rc
	out=$("$@" $PY_GATE_FILES 2>&1) && rc=0 || rc=$?
	[ "$rc" -eq 0 ] && return 0
	[ "$rc" -lt 2 ] || PY_GATE_TOOL_ERR=1
	PY_GATE_ISSUES="${PY_GATE_ISSUES}--- ${label} (exit ${rc}) ---"$'\n'"${out}"$'\n'
	return 0
}

if [ "$PY_GATE_TOOL_ERR" -eq 0 ]; then
	echo ""
	echo "=== Running ruff + mypy over every tracked .py (blocking) ==="
	# --no-fix explicitly, as the advisory ruff step does. Inert while
	# pyproject.toml sets no `fix = true`, but a gate that rewrites the working
	# tree mid-push and then reports clean is the same fail-open class this
	# whole block is written against.
	py_gate_run "ruff check" "$VENV_BIN/ruff" check --no-fix
	py_gate_run "ruff format --check" "$VENV_BIN/ruff" format --check
	py_gate_run "mypy --strict" "$VENV_BIN/mypy" --strict
	[ -n "$PY_GATE_ISSUES" ] || echo "ruff + mypy: clean"
fi

if [ -n "$PY_GATE_ISSUES" ]; then
	echo ""
	echo "═══════════════════════════════════════════"
	echo "  Python findings (blocking):"
	echo "═══════════════════════════════════════════"
	echo "$PY_GATE_ISSUES"
	echo "═══════════════════════════════════════════"
	echo ""
	if [ "$PY_GATE_TOOL_ERR" -ne 0 ]; then
		echo "FAILED: the Python gate could not run. That is a tooling or"
		echo "configuration fault, not a code finding -- ruff and mypy exit 1"
		echo "for findings and 2 or more for a fault -- so the advice below"
		echo "does not apply. Check the venv (\`.venv/bin/pip install -e '.[dev]'\`)"
		echo "and that the gated paths still exist."
	else
		echo "FAILED: every tracked .py is kept ruff-clean,"
		echo "ruff-format-clean and mypy --strict clean (issue #154). Fix the"
		echo "finding above -- \`ruff check --fix\` and \`ruff format\` handle most"
		echo "of it, and an untyped test function wants \`-> None\`. Do NOT widen"
		echo "an ignore list or add to PY_GATE_EXCLUDE to get a push through;"
		echo "that is the .clang-tidy disabled-list move in a different file."
	fi
	exit 1
fi

# ============================================================
# Step 2: Clean build + test (hard block)
# ============================================================

# Extract a fenced code block under "## Build & Test" by tag (e.g. ```build ... ```)
extract_block() {
	local tag="$1"
	if [ -f "CLAUDE.md" ]; then
		sed -n -e '/^## Build & Test/,/^## /{' \
			-e "/^\`\`\`${tag}$/,/^\`\`\`$/{ /^\`\`\`/d; p; }" \
			-e '}' CLAUDE.md
	fi
}

# Run one extracted block in a subshell, so an `exit` inside an extracted
# command cannot kill this hook mid-gate.
#
# GIT_DIR/GIT_WORK_TREE are unset defensively.  Some git versions export GIT_DIR
# into hook environments, and CMake's nested `git clone` inside FetchContent
# would then treat it as the repo it is cloning into and fail to check out the
# nlohmann/json or Catch2 tag.  Measured on git 2.53.0, `git push` does NOT
# export it to pre-push, so today this is insurance rather than a live fix —
# keep it, but don't cite it as the reason a build broke without re-measuring.
# Scoped to the subshell so this hook's own `git` calls are unaffected.
run_block() {
	set +e
	(
		unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
		eval "$1"
	)
	local rc=$?
	set -e
	return $rc
}

# Print the compiler warnings in a build log that are in this repository's own
# code: `$1` the log, `$2` the source root CMake recorded. Colour codes are
# stripped first. First-party is everything under the root EXCEPT the trees
# holding other people's code -- build*/ (FetchContent's _deps), .venv/
# (nanobind) and .claude/ (agent worktrees) -- so a new top-level source
# directory is gated rather than skipped. A relative path (ccache's base_dir
# rewrites them) counts as ours unless it names one of those trees.
first_party_warnings() {
	sed 's/\x1b\[[0-9;]*[mK]//g' "$1" | awk -v root="$2/" '
		/^[^ :]+:[0-9]+:([0-9]+:)? warning:/ {
			path = substr($0, 1, index($0, ":") - 1)
			if (substr(path, 1, 1) == "/") {
				if (index(path, root) != 1) next
				rest = substr(path, length(root) + 1)
				if (rest ~ /^(build[^\/]*|\.venv|\.claude)\//) next
			} else if (path ~ /(^|\/)(_deps|\.venv|site-packages)\//) next
			print
		}'
}

if [ -z "$CODE_FILES" ]; then
	echo ""
	echo "=== Skipping build+test (docs-only) ==="
else
	BUILD_FAILED=0
	CLEAN_CMD=$(extract_block clean)
	BUILD_CMD=$(extract_block build)
	TEST_CMD=$(extract_block test)

	# Both blocks are required.  Running whichever half resolves and skipping
	# the other in silence turns a renamed fence or a moved heading into
	# "All checks passed." on a push that never ran the tests.  There is also
	# no auto-detect fallback: guessing a build would gate a *different* build
	# than the documented one, which is the same failure wearing a hat.
	# CLAUDE.md's `## Build & Test` fences are the contract.
	if [ -z "$BUILD_CMD" ] || [ -z "$TEST_CMD" ]; then
		echo ""
		echo "Push blocked: could not extract the build/test commands from"
		echo "CLAUDE.md's '## Build & Test' section. Restore the fenced"
		echo "\`\`\`clean / \`\`\`build / \`\`\`test blocks there."
		[ -z "$BUILD_CMD" ] && echo "  missing: \`\`\`build"
		[ -z "$TEST_CMD" ] && echo "  missing: \`\`\`test"
		exit 1
	fi

	if [ -n "$CLEAN_CMD" ]; then
		echo ""
		echo "=== Clean ==="
		run_block "$CLEAN_CMD" || BUILD_FAILED=1
	fi
	if [ "$BUILD_FAILED" -eq 0 ]; then
		echo ""
		echo "=== Build ==="
		# Teed to a log so the compiler's own warnings can be gated below.
		# PIPESTATUS, not the pipeline's status, which is tee's.
		BUILD_LOG=$(git rev-parse --git-path cbls-pre-push-build.log)
		run_block "$BUILD_CMD" 2>&1 | tee "$BUILD_LOG"
		[ "${PIPESTATUS[0]}" -eq 0 ] || BUILD_FAILED=1
	fi
	# Compiler warnings in first-party code block, like clang-tidy findings
	# (issue #171). The clang-tidy sweep is clang's reading of the same -Wall
	# -Wextra; the build compiler (GCC here) has diagnostics clang lacks, and
	# at the commit that added this it reported two -Wrange-loop-construct the
	# sweep did not. No -Werror does this job instead -- CMakeLists.txt says
	# why. ccache replays a cached compile's warnings, so a warm cache does not
	# hide them.
	#
	# A scan that matches nothing looks exactly like a clean build, so it fails
	# OPEN on anything that changes the text -- colour codes
	# (CMAKE_COLOR_DIAGNOSTICS=ON splits ": warning:" with ESC[m), a
	# translated "warning:", a source path spelled differently from the one
	# assumed. Hence the positive control below: the gate probe TU is compiled
	# on its own and the same scan must find its -Wswitch, or the push blocks.
	if [ "$BUILD_FAILED" -eq 0 ]; then
		# The source root as CMake recorded it: the spelling GCC prints.
		SRC_ROOT=$(sed -n 's/^CMAKE_HOME_DIRECTORY:INTERNAL=//p' build/CMakeCache.txt 2>/dev/null)
		[ -n "$SRC_ROOT" ] || SRC_ROOT=$(pwd -P)
		BUILD_WARNINGS=$(first_party_warnings "$BUILD_LOG" "$SRC_ROOT")
		PROBE_LOG="${BUILD_LOG}.probe"
		# Its objects are removed first so the TU really compiles: an
		# up-to-date target prints nothing, which would read as a blind scan.
		# Only the objects: the directory also holds the generator's rules.
		find build/CMakeFiles/cbls_tidy_probe.dir -name '*.o' -delete 2>/dev/null || true
		(unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE && cmake --build build --target cbls_tidy_probe) >"$PROBE_LOG" 2>&1 || true
		if ! first_party_warnings "$PROBE_LOG" "$SRC_ROOT" | grep -F 'incomplete_switch.cpp' | grep -qF -- '-Wswitch'; then
			echo ""
			echo "Push blocked: the compiler-warning scan could not see the"
			echo "gate probe's -Wswitch in a build of cbls_tidy_probe, so it"
			echo "would miss real warnings too. Its output was:"
			head -20 "$PROBE_LOG"
			BUILD_FAILED=1
		elif [ -n "$BUILD_WARNINGS" ]; then
			echo ""
			echo "Push blocked: the build emitted compiler warnings in this"
			echo "repository's own code. Fix them -- the tree is held at zero:"
			echo "$BUILD_WARNINGS"
			BUILD_FAILED=1
		fi
	fi
	if [ "$BUILD_FAILED" -eq 0 ]; then
		echo ""
		echo "=== Test ==="
		run_block "$TEST_CMD" || BUILD_FAILED=1
	fi

	if [ "$BUILD_FAILED" -ne 0 ]; then
		echo ""
		echo "Push blocked: build or tests failed."
		exit 1
	fi
fi

# ============================================================
# Step 3: Remaining issues (clang-tidy blocks; everything else warns)
# ============================================================

ISSUES=""
TIDY_ISSUES=""
TIDY_CONFIG_ERR=0""

# clang-tidy (non-fixable warnings).  Prefer the venv's pinned copy over PATH,
# for the same reason pre-commit does: a different major version reports a
# different set, and with no system clang-tidy the bare `command -v` guard
# skipped this step in silence while the docs claimed it ran.
CLANG_TIDY=""
[ -x "$VENV_BIN/clang-tidy" ] && CLANG_TIDY="$VENV_BIN/clang-tidy"
[ -z "$CLANG_TIDY" ] && command -v clang-tidy &>/dev/null && CLANG_TIDY="clang-tidy"

if [ -n "$CPP_FILES" ] && [ -n "$CLANG_TIDY" ]; then
	COMPILE_DB=""
	[ -f "build/compile_commands.json" ] && COMPILE_DB="-p build"
	[ -f "compile_commands.json" ] && COMPILE_DB="-p ."

	if [ -n "$COMPILE_DB" ]; then
		echo ""
		echo "=== Running clang-tidy ==="

		# clang-tidy BLOCKS. The tree is at zero warnings. The ratchet that
		# got it there -- checks disabled by name with their unfixed finding
		# counts -- is empty as of issue #121; what is still disabled in
		# .clang-tidy is six structural exemptions, each off because the
		# check is wrong for this codebase and each carrying the measurement
		# that says so. A warning here is therefore new code's, and the fix
		# is to fix it -- not to add another name to that list.
		# Match case-insensitively and gate on the exit status too. A
		# misconfigured directory makes clang-tidy exit 1 with the single
		# line "Error: no checks enabled." -- capital E, which the old
		# lower-case-only pattern missed, so every file under src/io/ went
		# unlinted while this step reported success. Failing open is the
		# one thing a hard gate must not do.
		for f in $CPP_FILES; do
			[ -f "$f" ] || continue
			# `... && rc=0 || rc=$?` rather than a bare assignment:
			# `set -e` is on at the top of this file, so an unguarded `RESULT=$(cmd)`
			# whose command exits nonzero would abort the hook here
			# instead of collecting the finding and reporting it below.
			RESULT=$("$CLANG_TIDY" $COMPILE_DB \
				--quiet "$f" 2>&1) && TIDY_RC=0 || TIDY_RC=$?
			if [ "$TIDY_RC" -ne 0 ]; then
				# A nonzero exit is a clang-tidy/config fault, not a code
				# finding. It prints ~750 lines of usage text after the one
				# line that matters, which over a whole changeset scrolls
				# the cause off the top. Keep the cause, drop the manual,
				# and name the file -- the raw output names nothing.
				TIDY_CONFIG_ERR=1
				TIDY_ISSUES="${TIDY_ISSUES}${f}: clang-tidy exited ${TIDY_RC}"$'\n'
				TIDY_ISSUES="${TIDY_ISSUES}$(echo "$RESULT" | head -5)"$'\n'
			elif echo "$RESULT" | grep -qiE '(warning|error):'; then
				TIDY_ISSUES="${TIDY_ISSUES}${RESULT}"$'\n'
			fi
		done
	fi
fi

# The gate probe (see TIDY_PROBE above). A failure is a configuration fault
# of the gate, not a finding in the pushed code, so it is reported as one.
if [ "$TIDY_PROBE" -eq 1 ]; then
	echo ""
	echo "=== clang-tidy gate probe ==="
	PROBE_DB=""
	[ -f "build/compile_commands.json" ] && PROBE_DB="build"
	[ -f "compile_commands.json" ] && PROBE_DB="."
	# Pinned copy only, as for the ctest: another vintage rejects keys this
	# .clang-tidy uses, and would fail the probe for the wrong reason. A probe
	# that cannot run blocks -- skipping it is the fail-open this step exists
	# to prevent. The working tree's copy, not "$0"'s neighbour: core.hooksPath
	# may point at another checkout's .githooks.
	if [ ! -x "$VENV_BIN/clang-tidy" ] || [ -z "$PROBE_DB" ]; then
		TIDY_CONFIG_ERR=1
		TIDY_ISSUES="${TIDY_ISSUES}tidy-probe could not run: it needs $VENV_BIN/clang-tidy and a compile database"$'\n'
	else
		RESULT=$(bash .githooks/tidy-probe.sh "$VENV_BIN/clang-tidy" "$PROBE_DB" 2>&1) && PROBE_RC=0 || PROBE_RC=$?
		echo "$RESULT"
		if [ "$PROBE_RC" -ne 0 ]; then
			TIDY_CONFIG_ERR=1
			TIDY_ISSUES="${TIDY_ISSUES}tidy-probe exited ${PROBE_RC}:"$'\n'"${RESULT}"$'\n'
		fi
	fi
fi

# ruff complexity (C901, not auto-fixable)
if [ -n "$PY_FILES" ] && [ -x "$VENV_BIN/ruff" ]; then
	for f in $PY_FILES; do
		[ -f "$f" ] || continue
		RESULT=$("$VENV_BIN/ruff" check --select C901 --no-fix "$f" 2>&1 || true)
		if [ -n "$RESULT" ] && ! echo "$RESULT" | grep -q "^All checks passed"; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

# Shell lint warnings
if [ -n "$SH_FILES" ] && command -v shellcheck &>/dev/null; then
	for f in $SH_FILES; do
		[ -f "$f" ] || continue
		RESULT=$(shellcheck "$f" 2>&1 || true)
		if [ -n "$RESULT" ]; then
			ISSUES="${ISSUES}${RESULT}"$'\n'
		fi
	done
fi

# mypy type errors.  Deleted paths are filtered out first: unlike the loops
# above, mypy takes the whole list at once and stops at the first unreadable
# file ("errors prevented further checking"), so one .py removed by this push
# would both fake a failure and mask real type errors in every surviving file.
MYPY_FILES=""
for f in $PY_FILES; do
	if [ -f "$f" ]; then
		MYPY_FILES="${MYPY_FILES}${f}"$'\n'
	fi
done
if [ -n "$MYPY_FILES" ] && [ -x "$VENV_BIN/mypy" ]; then
	echo ""
	echo "=== Running mypy ==="
	RESULT=$("$VENV_BIN/mypy" --strict $MYPY_FILES 2>&1 || true)
	if echo "$RESULT" | grep -qE '(error):'; then
		ISSUES="${ISSUES}${RESULT}"$'\n'
	else
		echo "mypy: clean"
	fi
fi

# clang-tidy findings are a hard block; everything below stays advisory.
if [ -n "$TIDY_ISSUES" ]; then
	echo ""
	echo "═══════════════════════════════════════════"
	echo "  clang-tidy findings (blocking):"
	echo "═══════════════════════════════════════════"
	echo "$TIDY_ISSUES"
	echo "═══════════════════════════════════════════"
	echo ""
	if [ "$TIDY_CONFIG_ERR" -ne 0 ]; then
		echo "FAILED: clang-tidy could not run. That is a configuration"
		echo "fault, not a code finding, so the advice below does not apply:"
		echo "check .clang-tidy and any per-directory config -- a nested"
		echo ".clang-tidy needs \`InheritParentConfig: true\`, or it REPLACES"
		echo "the root check list and leaves nothing enabled (issue #121)."
		echo "If tidy-probe failed, the gate runs but is blind to compiler"
		echo "diagnostics: its output above names which half is missing"
		echo "(issue #171)."
	else
		echo "FAILED: the tree is kept at zero clang-tidy warnings."
		echo "Fix the finding above. Do NOT silence it by adding the check to"
		echo "the disabled list in .clang-tidy -- the ratchet of pre-existing"
		echo "findings is empty (issue #121), and what is left there is six"
		echo "structural exemptions, each with a measurement. Adding a seventh"
		echo "needs the same standard, not a red gate."
	fi
	exit 1
fi

# If issues found, warn but allow push
if [ -n "$ISSUES" ]; then
	echo ""
	echo "═══════════════════════════════════════════"
	echo "  Issues found:"
	echo "═══════════════════════════════════════════"
	echo "$ISSUES"
	echo "═══════════════════════════════════════════"
	echo ""
	echo "Warning: pushing with known issues."
else
	echo ""
	echo "All checks passed."
fi

exit 0
